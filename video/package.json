{
  "name": "ai-explainer-video",
  "version": "1.0.0",
  "description": "10-second mixed-media collage explainer video about AI, built with Remotion",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render src/index.ts AiExplainer out/ai-explainer.mp4 --browser-executable=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell",
    "render:crime": "remotion render src/index.ts CrimePsych out/crime-psychology.mp4 --browser-executable=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell",
    "still": "remotion still src/index.ts AiExplainer out/still.png --browser-executable=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/cli": "4.0.516",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-peeps": "^0.1.10",
    "remotion": "4.0.516"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "typescript": "5.4.5"
  }
}
