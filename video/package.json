{
  "name": "ai-explainer-video",
  "version": "1.0.0",
  "description": "10-second mixed-media collage explainer video about AI, built with Remotion",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render src/index.ts AiExplainer out/ai-explainer.mp4 --browser-executable=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell",
    "render:crime": "remotion render src/index.ts CrimePsych out/crime-psychology.mp4 --browser-executable=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell",
    "render:crime:vo": "remotion render src/index.ts CrimePsych out/crime-psychology-vo.mp4 --props={\"voiceover\":true} --browser-executable=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell",
    "voiceover:local": "python3 scripts/generate_voiceover.py",
    "voiceover:cloud": "node scripts/generate-voiceover.mjs",
    "still": "remotion still src/index.ts AiExplainer out/still.png --browser-executable=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell",
    "upgrade": "remotion upgrade",
    "finalize:crime": "bash scripts/mux_voiceover.sh",
    "render:episode1": "remotion render src/index.ts Episode1 out/episode1-main.mp4 --browser-executable=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell --concurrency=4",
    "render:episode1:bumpers": "remotion render src/index.ts WelcomeBumper out/welcome.mp4 --browser-executable=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell && remotion render src/index.ts Outro out/outro.mp4 --browser-executable=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell",
    "still:thumbnail": "remotion still src/index.ts Thumbnail out/thumbnail.png --browser-executable=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell"
  },
  "dependencies": {
    "@remotion/cli": "4.0.516",
    "d3-geo": "^3.1.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-peeps": "^0.1.10",
    "remotion": "4.0.516",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/react": "19.0.0",
    "@types/topojson-client": "^3.1.5",
    "kokoro-fp16-shards": "^1.0.4",
    "kokoro-js": "^1.2.1",
    "typescript": "5.4.5"
  }
}
